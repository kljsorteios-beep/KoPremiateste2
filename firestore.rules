rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /publico/{documentId} {
      allow read: if documentId == 'rifa';
      allow write: if false;
    }

    match /usuarios/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /pedidos/{pedidoId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /compras/{compraId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // A disponibilidade real, os números premiados e os documentos de cotas
    // nunca são expostos ao navegador. As funções usam Admin SDK.
    match /cotas/{numeroId} {
      allow read, write: if false;
    }

    match /disponibilidade/{shardId} {
      allow read, write: if false;
    }

    match /numerosPremiados/{numeroId} {
      allow read, write: if false;
    }

    match /configuracoes/{documentId} {
      allow read, write: if false;
    }

    match /estado/{documentId} {
      allow read, write: if false;
    }

    match /auditoriaGeracoes/{documentId} {
      allow read, write: if false;
    }

    // Resultados e dados dos ganhadores nunca são lidos diretamente pelo cliente.
    // As funções administrativas usam o Admin SDK após validar o administrador.
    match /ganhadores/{documentId} {
      allow read, write: if false;
    }

    match /sorteios/{documentId} {
      allow read, write: if false;
    }
  }
}
