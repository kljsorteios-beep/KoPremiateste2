{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "functions/**",
      "scripts/**",
      "generated-raffle/**",
      "**/.*",
      "**/node_modules/**",
      "vercel.json",
      "env.example",
      "sdkconfig.json",
      "premios*.json",
      "download",
      "*.md",
      "*.log"
    ],
    "cleanUrls": false
  }
}
